table weekly_overbooking
	lineageTag: 279ce628-bb94-413a-b528-d6be7db74cd7

	measure 'Actual Cancellations' = SUM(weekly_overbooking[actual_cancellations])
		formatString: #,0
		lineageTag: 76c0a5eb-1bc8-471d-a4f7-1e273df77113

	measure 'Forecast Cancellations' = SUM(weekly_overbooking[expected_cancellations])
		formatString: #,0
		lineageTag: 3a1b02c0-3532-41af-91a2-b6ef1f31832c

	measure 'Safe Overbooking' = SUM(weekly_overbooking[safe_overbook_rooms])
		formatString: #,0
		lineageTag: 3aeb7797-2d54-468f-9a8a-6972a501b691

	measure 'Recoverable Revenue (upper bound)' = SUM(weekly_overbooking[revenue_recoverable])
		formatString: #,0
		lineageTag: 1f22893e-02b1-48fd-b88f-e7146ba494a4

	column hotel
		dataType: string
		lineageTag: c8ed9223-23e7-4842-bae9-bedda04f292a
