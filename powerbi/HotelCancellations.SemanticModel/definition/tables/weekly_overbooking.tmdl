		sourceColumn: week

		variation Variation
			isDefault
			relationship: 4f4dff89-94fd-4f11-a608-b3c4778fc2bf
			defaultHierarchy: LocalDateTable_dfe6dd8b-0e30-4b3e-a347-d8029bc30518.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column bookings
		dataType: int64
		formatString: 0
		lineageTag: 5c329c94-b7d4-4d4a-ae80-b0ad5f376737
		summarizeBy: sum
		sourceColumn: bookings

		annotation SummarizationSetBy = Automatic

	column actual_cancellations
