table fact_bookings
	lineageTag: 0956a9a5-614a-4569-a85a-9fc92b277b8d

	measure Bookings = COUNTROWS(fact_bookings)
		formatString: #,0
		lineageTag: f5a54964-baa0-412e-b2db-ea3e43dc50f0

	measure Cancellations = SUM(fact_bookings[is_canceled])
		formatString: #,0
		lineageTag: 131f0bd9-8626-4fb8-aa01-ee293f331737

	measure 'Cancel Rate' = DIVIDE([Cancellations], [Bookings])
		formatString: 0.0%
		lineageTag: 6835dade-5354-4b10-8e50-a9edf2bf2b0a

	measure 'Realized Revenue' = CALCULATE(SUM(fact_bookings[room_revenue]), fact_bookings[is_canceled] = 0)
		formatString: #,0
		lineageTag: 8471a959-95db-4de3-9215-240af912e941

	measure 'Revenue Lost' = CALCULATE(SUM(fact_bookings[room_revenue]), fact_bookings[is_canceled] = 1)
		formatString: #,0
		lineageTag: 734c7d51-b5c3-4792-bb97-b734a56355ae

	measure 'Pct Revenue Lost' = DIVIDE([Revenue Lost], [Realized Revenue] + [Revenue Lost])
		formatString: 0.0%
		lineageTag: 1ea105bb-c413-401a-ba1f-9cb93c3276df

	measure 'Avg Daily Rate' = CALCULATE(AVERAGE(fact_bookings[adr]), fact_bookings[is_canceled] = 0)
		formatString: #,0.00
		lineageTag: 5cb84c14-8067-402e-a7a6-530b72862105

	measure 'Avg Predicted Risk' = AVERAGE(fact_bookings[cancel_risk])
		formatString: 0.0%
		lineageTag: d3b87ae2-d4a8-49d1-a5f7-4f6bbc4dbae1

	measure 'Cancel Rate (100+ bookings)' = IF([Bookings] >= 100, [Cancel Rate])
		formatString: 0.0%
		lineageTag: d619a533-10d1-40fd-8b86-490674d2aa5e

	measure 'Test Bookings' = CALCULATE([Bookings], fact_bookings[risk_band] <> "Not scored (training period)")
		formatString: #,0
		lineageTag: 386bd8b0-3740-4f7c-b403-0a7153ff69de

	measure 'Test Cancel Rate' = CALCULATE([Cancel Rate], fact_bookings[risk_band] <> "Not scored (training period)")
		formatString: 0.0%
		lineageTag: 44dd6965-c746-4cfa-aa9b-f18a7a004c95

