table gains_curve
	lineageTag: 61d879cf-8e85-42bf-a941-caf0fd1914de

	measure 'Cancellations Captured (%)' = SUM(gains_curve[pct_cancellations_captured])
		formatString: 0.0
		lineageTag: bc11ed7e-eaa7-4030-9def-0f6ec7308a49

	column model
		dataType: string
		lineageTag: e06acce3-483f-46b7-b4ec-f2b0587dcbc7
		summarizeBy: none
		sourceColumn: model

		annotation SummarizationSetBy = Automatic

	column pct_bookings_targeted
		dataType: int64
		formatString: 0
		lineageTag: 31eac3ca-b4eb-4954-af56-b2b26ab5f2cb
		summarizeBy: none
		sourceColumn: pct_bookings_targeted

		annotation SummarizationSetBy = Automatic

	column pct_cancellations_captured
		dataType: double
		lineageTag: 3ea9f6f2-658f-419e-9670-e22a518935a4
		summarizeBy: sum
		sourceColumn: pct_cancellations_captured

		annotation SummarizationSetBy = Automatic

	partition gains_curve = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\gains_curve.csv"),[Delimiter=",", Columns=3, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"model", type text}, {"pct_bookings_targeted", Int64.Type}, {"pct_cancellations_captured", type number}}, "en-US")
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

